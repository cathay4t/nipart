%%{init: {"theme":"base","themeVariables":{"fontFamily":"Inter, PingFang SC, Microsoft YaHei, sans-serif","fontSize":"16px","primaryColor":"#ffffff","primaryBorderColor":"#cbd5e1","primaryTextColor":"#0f172a","lineColor":"#94a3b8","edgeLabelBackground":"#ffffff"}}}%%

flowchart TB
    %% ============ Clients ============
    subgraph CLIENTS["Clients"]
        NPT["npt CLI<br/>show · apply · wifi · ..."]
        PYN["Python client"]
        NOD["npt -n daemonless mode"]
    end

    %% ============ IPC ============
    subgraph IPC["IPC · UNIX socket, size + JSON"]
        SOCK["/var/run/nipart/sockets/daemon"]
    end

    %% ============ Daemon ============
    subgraph DAE["Daemon · nipartd (Rust / tokio)"]
        CORE["commander dispatcher<br/>conf · event · monitor · dhcp · plugin managers"]
    end

    %% ============ Plugins + engine ============
    subgraph MID["Plugins & Kernel Engine"]
        PL["Plugins · separate processes<br/>plugin-wifi · plugin-ovs · third-party"]
        NODA["no_daemon kernel apply engine<br/>apply · query · watcher"]
    end

    %% ============ Kernel ============
    subgraph KRN["Kernel · System Layer"]
        N["nispor · rtnetlink · nl80211<br/>netlink query / modify / WiFi"]
        KS["Linux kernel network subsystem<br/>ip · route · bond · bridge · vlan · vxlan"]
    end

    %% ============ Edges ============
    NPT -->|"query / apply"| SOCK
    PYN --> SOCK
    SOCK --> CORE
    CORE --> PL
    CORE --> NODA
    NOD -.->|"skip daemon"| NODA
    NODA --> N
    N --> KS
    PL -.->|"WiFi scan"| N

