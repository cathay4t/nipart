%% Nipart 架构图（PPT 展示用 · 简化版）
%% 渲染: mmdc -i docs/architecture.mmd -o docs/architecture.svg
%%{init: {"theme":"base","themeVariables":{"fontFamily":"Inter, PingFang SC, Microsoft YaHei, sans-serif","fontSize":"16px","primaryColor":"#ffffff","primaryBorderColor":"#cbd5e1","primaryTextColor":"#0f172a","lineColor":"#94a3b8","edgeLabelBackground":"#ffffff"}}}%%

flowchart TB
    %% ============ 客户端层 ============
    subgraph CLIENTS["客户端 · Clients"]
        NPT["npt CLI<br/>show · apply · wifi · ..."]
        PYN["Python 客户端"]
        NOD["npt -n 无守护进程模式"]
    end

    %% ============ IPC ============
    subgraph IPC["IPC · UNIX socket, size + JSON"]
        SOCK["/var/run/nipart/sockets/daemon"]
    end

    %% ============ 守护进程 ============
    subgraph DAE["守护进程 · nipartd (Rust / tokio)"]
        CORE["commander 分发中枢<br/>conf · event · monitor · dhcp · plugin 各 manager"]
    end

    %% ============ 插件 + 引擎 ============
    subgraph MID["插件与内核引擎"]
        PL["插件 · 独立进程<br/>plugin-wifi · plugin-ovs · 第三方"]
        NODA["no_daemon 内核应用引擎<br/>apply · query · watcher"]
    end

    %% ============ 内核 ============
    subgraph KRN["内核 · 系统层"]
        N["nispor · rtnetlink · nl80211<br/>netlink 查询 / 修改 / WiFi"]
        KS["Linux 内核网络子系统<br/>ip · route · bond · bridge · vlan · vxlan"]
    end

    %% ============ 连接 ============
    NPT -->|"查询 / 应用"| SOCK
    PYN --> SOCK
    SOCK --> CORE
    CORE --> PL
    CORE --> NODA
    NOD -.->|"跳过守护进程"| NODA
    NODA --> N
    N --> KS
    PL -.->|"WiFi 扫描"| N

    %% ============ 样式 ============
    classDef client fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#1e3a8a;
    classDef ipc fill:#f1f5f9,stroke:#64748b,stroke-width:2px,color:#334155;
    classDef daemon fill:#ede9fe,stroke:#7c3aed,stroke-width:2px,color:#4c1d95;
    classDef mid fill:#d1fae5,stroke:#059669,stroke-width:2px,color:#064e3b;
    classDef kern fill:#e2e8f0,stroke:#475569,stroke-width:2px,color:#1e293b;

    class NPT,PYN,NOD client;
    class SOCK ipc;
    class CORE daemon;
    class PL,NODA mid;
    class N,KS kern;
